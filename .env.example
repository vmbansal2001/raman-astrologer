# Public website origin; keep the production domain for canonical metadata.
NEXT_PUBLIC_SITE_URL=https://ramanastrologer.com

# Sanity project: astrologer-raman.
NEXT_PUBLIC_SANITY_PROJECT_ID=xqbous5j
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token for protected draft preview. Never prefix this with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
# Editor token for the one-time import. Not exposed to the browser.
SANITY_API_WRITE_TOKEN=

# Verify the destination inbox in Formspree before enabling live submissions.
FORMSPREE_FORM_ID=
ENQUIRIES_ENABLED=false

# Optional measurement. No enquiry contents or birth details are tracked.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
GOOGLE_SITE_VERIFICATION=
